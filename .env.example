# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL connection string. Neon (Vercel Marketplace) or a local Postgres, e.g.
# postgres://user:password@localhost:5432/alpha_manage
DATABASE_URL=

# Optional direct (non-pooled) connection used by db:migrate. Neon's Vercel integration sets it.
DATABASE_URL_UNPOOLED=

# A SEPARATE database (e.g. a Neon branch) for tests/integration. Tests apply migrations to it and
# insert/delete rows, so it must never be the main database. Without it integration tests are skipped.
TEST_DATABASE_URL=

# Secret used to sign sessions. At least 32 characters, e.g. `openssl rand -base64 32`.
AUTH_SECRET=

# File storage backend: "vercel-blob" (Vercel) or "local" (local disk, self-hosting / development).
STORAGE_DRIVER=local

# Required only when STORAGE_DRIVER=vercel-blob.
BLOB_READ_WRITE_TOKEN=
